GITHUB_USERNAME=your-github-username
# Accepts owner/repository. The token needs Contents: Read and write for this repository.
GITHUB_TARGET_REPO=italia-corpus
GIT_AUTHOR_NAME=your-github-username
GIT_AUTHOR_EMAIL=your-github-username@users.noreply.github.com
# The container reads this secret file. Do not put the token in this file.
GITHUB_TOKEN_FILE=/run/secrets/github_token
PUBLISH_TARGET=github
# For GitLab, Codeberg, Gitea, or another Git server, use PUBLISH_TARGET=git.
# GIT_TARGET_URL=https://git.example.com/owner/italia-corpus.git
# GIT_TARGET_BRANCH=main
# GIT_TARGET_USERNAME=x-access-token
# PUBLISH_TOKEN_FILE=/run/secrets/github_token
ITALIA_CORPUS_DATA_DIR=/mnt/storage/DATA/italia-corpus-runner
ROOT_PATH=/data/work
DOWNLOAD_CACHE_PATH=/data/download-cache
CHECK_INTERVAL_SECONDS=86400
FULL_RUN_INTERVAL_SECONDS=2592000
# Failed full runs retry from the persisted .partial downloads after this delay.
RETRY_DELAY_SECONDS=3600
LOGLEVEL=INFO
# Comma-separated canonical collection precedence. Defaults to Codici.
CANONICAL_COLLECTION_PRIORITY=Codici
